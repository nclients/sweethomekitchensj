---
import { getImagesFromFolders } from "../utils/readImages";
import { cn } from "../utils/cn";

const { section } = Astro.props;
const images = getImagesFromFolders("/public/" + section?.folderPath);
---

<section
  id={`${section?.id || ""}`}
  class={cn(section?.noMarginTop ? "pt-0" : "pt-16 sm:pt-24 md:pt-32")}
>
  {
    section?.mode === 1 && (
      <div style={`background-color:${section?.bgColor}`}>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-2xl">
            <h2 class="text-3xl font-bold  text-gray-900 sm:text-4xl text-center">
              {section?.title?.map((line: string, index: number) => (
                <Fragment key={index}>
                  <span class="block leading-16">{line}</span>
                </Fragment>
              ))}
            </h2>

            {section?.description?.map((info: string, index: number) => (
              <Fragment key={index}>
                <p class="mt-4 text-lg leading-8 text-gray-600 text-center">
                  {info}
                </p>
              </Fragment>
            ))}
          </div>

          <div class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-16 sm:mt-20 lg:mx-0 lg:max-w-none text-center">
            {images?.map((item, index) => (
              <Fragment key={index}>
                <div>
                  <div class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900">
                    <img
                      src={item?.src?.replace("/public", "")}
                      alt={item?.name}
                      class="w-full object-contain cursor-pointer"
                      loading="lazy"
                      data-src={item?.src}
                      tabindex="0"
                    />
                  </div>
                  {section?.showImgName ? (
                    <div
                      class="mt-3 text-lg leading-6 text-shadow-all shadow-gray-100"
                      style={`color: ${section?.imgNameColor}`}
                    >
                      <span class="text-center">
                        <span class="absolute inset-0" />
                        {item?.name.split("__").map((part, subIndex) => (
                          <Fragment key={subIndex}>
                            {part
                              ?.replace(/_/g, " ")
                              ?.replace(/w:/g, "w/")
                              ?.replace(/w:o/g, "w/o")}
                            <br />
                            <br />
                          </Fragment>
                        ))}
                      </span>
                    </div>
                  ) : (
                    ""
                  )}
                </div>
              </Fragment>
            ))}
          </div>
        </div>
      </div>
    )
  }

  {
    section?.mode === 2 && (
      <div style={`background-color:${section?.bgColor}`}>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-2xl">
            <h2 class="text-3xl font-bold  text-gray-900 sm:text-4xl text-center">
              {section?.title?.map((line: string, index: number) => (
                <Fragment key={index}>
                  <span class="block leading-16">{line}</span>
                </Fragment>
              ))}
            </h2>

            {section?.description?.map((info: string, index: number) => (
              <Fragment key={index}>
                <p class="mt-4 text-lg leading-8 text-gray-600 text-center">
                  {info}
                </p>
              </Fragment>
            ))}
          </div>
          <div class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 sm:grid-cols-2 gap-16 sm:mt-20 lg:mx-0 lg:max-w-none text-center">
            {images?.map((item, index) => (
              <Fragment key={index}>
                <div>
                  <div class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900">
                    <img
                      src={item?.src?.replace("/public", "")}
                      alt={item?.name}
                      class="w-full object-contain cursor-pointer"
                      loading="lazy"
                      data-src={item?.src}
                      tabindex="0"
                    />
                  </div>
                  {section?.showImgName ? (
                    <div
                      class="mt-3 text-lg leading-6 text-shadow-all shadow-gray-100"
                      style={`color: ${section?.imgNameColor}`}
                    >
                      <span class="text-center">
                        <span class="absolute inset-0" />
                        {item?.name.split("__").map((part, subIndex) => (
                          <Fragment key={subIndex}>
                            {part
                              ?.replace(/_/g, " ")
                              ?.replace(/w:/g, "w/")
                              ?.replace(/w:o/g, "w/o")}
                            <br />
                            <br />
                          </Fragment>
                        ))}
                      </span>
                    </div>
                  ) : (
                    ""
                  )}
                </div>
              </Fragment>
            ))}
          </div>
        </div>
      </div>
    )
  }
  {
    section?.mode === 3 && (
      <div style={`background-color:${section?.bgColor}`}>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="flex flex-col justify-center items-center mx-auto max-w-2xl">
            <h2 class="text-3xl font-bold  text-gray-900 sm:text-4xl text-center">
              {section?.title?.map((line: string, index: number) => (
                <Fragment key={index}>
                  <span class="block leading-16">{line}</span>
                </Fragment>
              ))}
            </h2>

            {section?.description?.map((info: string, index: number) => (
              <Fragment key={index}>
                <p class="mt-4 text-lg leading-8 text-gray-600 text-center">
                  {info}
                </p>
              </Fragment>
            ))}
          </div>
          <ul
            role="list"
            class="mx-auto mt-8 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 xl:grid-cols-3"
          >
            {images?.map((item, index) => (
              <Fragment key={index}>
                <li>
                  <img
                    src={item?.src?.replace("/public", "")}
                    alt={item?.name}
                    class={`aspect-[14/13] w-full rounded-2xl object-cover rounded-${section?.menuItemImgRounded} hover:scale-105 duration-300 object-contain cursor-pointer`}
                    loading="lazy"
                    data-src={item?.src}
                    tabindex="0"
                  />
                  {section?.showImgName ? (
                    <div
                      class="mt-6 text-lg leading-8  text-center"
                      style={`color: ${section?.imgNameColor}`}
                    >
                      {item?.name.split("__").map((part) => (
                        <span>
                          {part
                            ?.replace(/_/g, " ")
                            ?.replace(/w:/g, "w/")
                            ?.replace(/w:o/g, "w/o")}
                          <br />
                        </span>
                      ))}
                    </div>
                  ) : (
                    ""
                  )}
                </li>
              </Fragment>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  {
    section?.mode === 4 && (
      <div style={`background-color:${section?.bgColor}`}>
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="flex flex-col justify-center items-center mx-auto max-w-2xl">
            <h2 class="text-3xl font-bold  text-gray-900 sm:text-4xl text-center">
              {section?.title?.map((line: string, index: number) => (
                <Fragment key={index}>
                  <span class="block leading-16">{line}</span>
                </Fragment>
              ))}
            </h2>

            {section?.description?.map((info: string, index: number) => (
              <Fragment key={index}>
                <p class="mt-4 text-lg leading-8 text-gray-600 text-center">
                  {info}
                </p>
              </Fragment>
            ))}
          </div>
          <div data-gallery-wrapper>
          <ul
            role="list"
            data-gallery-list
            class="mx-auto mt-8 grid max-w-2xl grid-cols-1 gap-y-6 px-8 sm:px-0 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-14 lg:mx-0 lg:max-w-none lg:grid-cols-3 xl:grid-cols-4"
          >
            {images?.map((item, index) => (
              <Fragment key={index}>
                <li data-gallery-item data-item-index={index}>
                  <img
                    src={item?.src?.replace("/public", "")}
                    alt={item?.name}
                    class={`aspect-[14/13] w-full rounded-2xl object-cover rounded-${section?.menuItemImgRounded} hover:scale-105 duration-300 object-contain cursor-pointer`}
                    loading="lazy"
                    data-src={item?.src}
                    tabindex="0"
                  />
                  {section?.showImgName ? (
                    <div
                      class="mt-6 text-lg leading-8  text-center"
                      style={`color: ${section?.imgNameColor}`}
                    >
                      {item?.name.split("__").map((part) => (
                        <span>
                          {part
                            ?.replace(/_/g, " ")
                            ?.replace(/w:/g, "w/")
                            ?.replace(/w:o/g, "w/o")}
                          <br />
                        </span>
                      ))}
                    </div>
                  ) : (
                    ""
                  )}
                </li>
              </Fragment>
            ))}
          </ul>
          {images?.length > 5 && (
            <div class="text-center mt-10">
              <button
                data-gallery-more-btn
                class="inline-block rounded-md px-6 py-3 text-base font-semibold text-white shadow-sm hover:scale-105 transition-transform"
                style={`background-color:${section?.buttonBgColor || "#E7383D"}`}
              >
                Show More
              </button>
            </div>
          )}
          </div>
        </div>
      </div>
    )
  }
</section>

<style is:global>
  /* Mobile: show first 5 only */
  [data-gallery-wrapper] [data-gallery-item]:nth-child(n+6) { display: none; }
  /* Desktop (≥768px): show first 8 */
  @media (min-width: 768px) {
    [data-gallery-wrapper] [data-gallery-item]:nth-child(6),
    [data-gallery-wrapper] [data-gallery-item]:nth-child(7),
    [data-gallery-wrapper] [data-gallery-item]:nth-child(8) { display: block; }
    [data-gallery-wrapper] [data-gallery-item]:nth-child(n+9) { display: none; }
  }
  /* Expanded: show all */
  [data-gallery-wrapper].gallery-expanded [data-gallery-item] { display: block !important; }
</style>

<script>
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("[data-gallery-more-btn]");
    if (!btn) return;
    const wrapper = btn.closest<HTMLElement>("[data-gallery-wrapper]");
    if (!wrapper) return;
    const list = wrapper.querySelector("[data-gallery-list]");
    const expanded = wrapper.classList.toggle("gallery-expanded");
    btn.textContent = expanded ? "Show Less" : "Show More";
    if (!expanded && list) {
      list.closest("section")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  });
</script>
